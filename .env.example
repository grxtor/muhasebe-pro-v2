# =============================================================================
# Muhasebe Pro v2 — Ortam Değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
# =============================================================================

# PostgreSQL bağlantısı
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/muhasebe_pro_v2?schema=public"

# Auth.js
# `openssl rand -base64 32` ile üretin
AUTH_SECRET=""
# Production'da kendi domain'iniz: https://muhasebe.oceanyazilim.com
# Dev'de bırakabilirsiniz, Next.js otomatik algılar
AUTH_URL=""
# v5 trust proxy (Dokploy + Traefik arkasındayken gerekli)
AUTH_TRUST_HOST="true"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Node ortamı
NODE_ENV="development"
