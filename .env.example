# =============================================================================
# Muhasebe Pro v2 — Ortam Değişkenleri
# Bu dosyayı `.env.local` (geliştirme) veya `.env` (Docker) olarak kopyalayın
# ve değerleri doldurun.
# =============================================================================

# --- PostgreSQL bağlantısı ---
# Geliştirme — uzak DB:
#   postgresql://USER:PASSWORD@host:5432/dbname?schema=public
# Docker Compose içinde db servisini kullanırken:
#   postgresql://postgres:postgres@db:5432/muhasebe_pro_v2?schema=public
# Production — kendi sunucundaki postgres:
#   postgresql://muhasebe:GUCLU_SIFRE@127.0.0.1:5432/muhasebe?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@db:5432/muhasebe_pro_v2?schema=public"

# Docker Compose'da db servisi için root parola (compose dosyası kullanır)
POSTGRES_PASSWORD="CHANGE_ME"

# --- Auth.js (NextAuth v5) ---
# Üretmek için:  openssl rand -base64 32
AUTH_SECRET=""

# Uygulamanın yayınlanacağı URL (Auth callback'leri için)
# Dev:  http://localhost:3000
# Prod: https://muhasebe.alanadi.com
AUTH_URL="http://localhost:3000"

# Reverse proxy (Traefik / Nginx / Dokploy) arkasındaysan true bırak
AUTH_TRUST_HOST="true"

# --- Dosya yükleme ---
# Dev için boş bırakırsan ./uploads kullanılır
# Docker'da volume mount edildiği path: /app/uploads
UPLOAD_DIR=""

# --- Node ortamı ---
NODE_ENV="development"
