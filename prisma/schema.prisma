// Muhasebe Pro v2 — Prisma şeması
// Eski Blazor sürümündeki Entities.cs bire bir buraya çevrildi.
// Auth.js v5 + Prisma adapter tabloları (User/Account/Session/VerificationToken) dahildir.

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
//  Auth.js v5 — Prisma Adapter modelleri
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?

  adSoyad     String?
  sirketAdi   String?
  kayitTarihi DateTime @default(now())

  // Şu an aktif çalıştığı organizasyon
  currentOrgId String?

  accounts Account[]
  sessions Session[]

  sahipOlduguOrglar Organization[]       @relation("OrgOwner")
  uyelikler         OrganizationMember[]

  // Yaratıcı / "createdBy" ilişkileri (audit için)
  cariler         Cari[]
  hareketler      Hareket[]
  odemeNotlari    OdemeNotu[]
  faturalar       Fatura[]
  dekontlar       Dekont[]
  ayarlar         UserSettings?
  sirketBilgisi   SirketBilgisi?
  etiketler       Tag[]
  hatirlaticilar  Hatirlatici[]
  tekrarlayanlar  TekrarlayanKayit[]
  urunler         Urun[]
  stokHareketleri StokHareketi[]
  auditLogs       AuditLog[]
  cekSenetler     CekSenet[]
  kasalar         Kasa[]
  kasaHareketleri KasaHareketi[]
  distributorRaporlar DistributorRapor[] @relation("DistributorUser")
  muzikProfilleri MuzikProfil[]
  muzikGelirleri  MuzikGelir[]
  muzikHarcamalari MuzikHarcama[]
  sanatciOdemeleri SanatciOdemesi[]

  @@index([email])
  @@index([currentOrgId])
}

// ============================================================
//  Multi-tenant: Organization + Member + Invitation
// ============================================================

enum OrgRole {
  Owner          // Tam yetki + kullanıcı yönetimi
  Admin          // Tam yetki ama kullanıcı yönetemez
  Muhasebeci     // CRUD yapar
  Goruntuleyici  // Sadece okur
}

model Organization {
  id      String @id @default(cuid())
  ad      String
  slug    String @unique
  ownerId String
  owner   User   @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Şirket bilgileri (eski SirketBilgisi'nden taşındı)
  sirketAdi    String?
  vergiNo      String?
  vergiDairesi String?
  tcKimlikNo   String?
  adres        String?
  sehir        String?
  ulke         String  @default("Türkiye")
  telefon      String?
  email        String?
  website      String?
  iban         String?
  bankaAdi     String?
  logoUrl      String?

  // Modül toggle'ları (eski UserSettings'ten taşındı)
  modulFaturalar      Boolean @default(true)
  modulHareketler     Boolean @default(true)
  modulUrunler        Boolean @default(false)
  modulTekrarlayanlar Boolean @default(true)
  modulHatirlaticilar Boolean @default(true)
  modulEtiketler      Boolean @default(true)
  modulCekSenet       Boolean @default(false)
  modulKasa           Boolean @default(false)
  modulKdvBeyan       Boolean @default(false)
  modulDistributor    Boolean @default(false)
  modulTicaret        Boolean @default(false)
  modulAvans          Boolean @default(false)
  modulMuzik          Boolean @default(false)

  defaultKdvOrani   Decimal @default(20) @db.Decimal(5, 2)
  defaultParaBirimi String  @default("TRY") @db.VarChar(3)
  defaultVadeGun    Int     @default(30)

  uyeler   OrganizationMember[]
  davetler Invitation[]

  // Domain ilişkileri (org-bazlı izolasyon)
  cariler         Cari[]
  hareketler      Hareket[]
  odemeNotlari    OdemeNotu[]
  faturalar       Fatura[]
  dekontlar       Dekont[]
  etiketler       Tag[]
  hatirlaticilar  Hatirlatici[]
  tekrarlayanlar  TekrarlayanKayit[]
  urunler         Urun[]
  stokHareketleri StokHareketi[]
  auditLogs       AuditLog[]
  cekSenetler     CekSenet[]
  kasalar         Kasa[]
  kasaHareketleri KasaHareketi[]
  distributorRaporlar DistributorRapor[]
  muzikProfilleri  MuzikProfil[]
  muzikGelirleri   MuzikGelir[]
  muzikHarcamalari MuzikHarcama[]
  sanatciOdemeleri SanatciOdemesi[]

  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@index([ownerId])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(Goruntuleyici)
  invitedBy      String?
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole      @default(Goruntuleyici)
  token          String       @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([email])
  @@index([token])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
//  Domain — Muhasebe modelleri
// ============================================================

enum CariTipi {
  Musteri
  Tedarikci
  HerIkisi
  Harcama
}

// Harcama profili için alt-kategori (sadece tip=Harcama ise anlamlı)
enum HarcamaTuru {
  Genel       // Klasik genel harcama (kira, fatura, vs.)
  Promosyon   // Bir sanatçı/şarkı/video için yapılan promosyon (legacy alias)
  Avans       // Geri alınabilir ileri tarihli ödeme
  Ticaret     // Yatırım + getiri (alım-satım, döviz, kripto vs.)
  Sanatci     // Müzik sanatçısı (telif/payout alır)
  Promoter    // İçerik üreticisi / influencer (reklam karşılığı ödeme)
  Isbirlikci  // Mix engineer, master, yapımcı, tasarımcı vs.
}

// Promoter (içerik üreticisi) niş kategorisi
enum PromoterNiche {
  Anime
  Football
  Movie
  Formula1Car
  UFCMMA
  Trollface
  DanceVideos
  ModeClothes
  Manga
  TopBoySnowfall
  HighImpactShatter
}

// Promoter öncelik kademesi (renkli)
enum PromoterTier {
  Low   // kırmızı
  Mid   // mavi
  High  // yeşil
}

// Müzik yayın mağazası / platformu
enum MuzikMagaza {
  YouTube
  Spotify
  AppleMusic
  Deezer
  AmazonMusic
  TikTok
  Instagram
  SoundCloud
  Diger
}

// Müzik harcama kategorisi (opsiyonel)
enum MuzikHarcamaKategori {
  Reklam
  Tasarim
  Produksiyon
  Klip
  Mix
  Master
  Telif
  Diger
}

enum OdemeYonu {
  Alacak
  Borc
}

enum OdemeDurumu {
  Beklemede
  Odendi
  KismiOdendi
  Iptal
}

enum FaturaYonu {
  Gonderilen
  Gelen
}

enum FaturaDurumu {
  Beklemede
  Odendi
  KismiOdendi
  Iptal
}

enum HareketTipi {
  Borc
  Alacak
}

/// Müşteri / Tedarikçi profili. Eski "Cari" tablosu.
model Cari {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kod   String
  unvan String
  tip   CariTipi    @default(Musteri)
  // tip=Harcama olduğunda kullanılır (Promosyon/Avans/Ticaret/Genel/Sanatci/Promoter/Isbirlikci)
  harcamaTuru HarcamaTuru?

  vergiNo       String?
  vergiDairesi  String?
  tcKimlikNo    String?
  telefon       String?
  email         String?
  adres         String?
  sehir         String?
  acilisTarihi  DateTime @default(now()) @db.Date
  acilisBakiyesi Decimal  @default(0) @db.Decimal(18, 2)
  notlar        String?
  aktif         Boolean  @default(true)

  // -------- Promoter metadata (sadece harcamaTuru=Promoter ise dolu) --------
  promoterNiche     PromoterNiche?
  promoterTier      PromoterTier?
  promoterFollowers Int?
  promoterAvgViews  Int?
  promoterPricePerVideo Decimal? @db.Decimal(18, 2)
  promoterHasInstagram Boolean?
  promoterHasTikTok    Boolean?

  olusturmaTarihi DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  hareketler     Hareket[]
  odemeNotlari   OdemeNotu[]
  faturalar      Fatura[]
  etiketler      CariTag[]
  hatirlaticilar Hatirlatici[]
  tekrarlayanlar TekrarlayanKayit[]
  cekSenetler    CekSenet[]
  // Müzik modülü ilişkileri
  muzikProfilSanatcilari MuzikProfilSanatci[]
  muzikHarcamalari       MuzikHarcama[]         @relation("MuzikHarcamaPromoter")
  sanatciOdemeleri       SanatciOdemesi[]

  @@unique([userId, kod])
  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, aktif])
  @@index([organizationId, unvan])
}

/// Para hareketi — tahsilat veya ödeme kaydı.
model Hareket {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cariId Int
  cari   Cari @relation(fields: [cariId], references: [id], onDelete: Cascade)

  tarih       DateTime    @default(now()) @db.Date
  tip         HareketTipi
  tutar       Decimal     @db.Decimal(18, 2)
  paraBirimi  String      @default("TRY") @db.VarChar(3)
  aciklama    String?
  belgeNo     String?
  vadeTarihi  DateTime?   @db.Date

  olusturmaTarihi DateTime @default(now())

  // Müzik modülü köprü kayıtları (delete cascade için)
  muzikHarcama  MuzikHarcama?
  sanatciOdemesi SanatciOdemesi? @relation("SanatciOdemesiHareket")

  @@index([userId, tarih(sort: Desc)])
  @@index([organizationId, tarih(sort: Desc)])
  @@index([cariId])
}

/// Alacak/Borç notu — bekleyen ödeme takibi.
model OdemeNotu {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cariId Int
  cari   Cari @relation(fields: [cariId], references: [id], onDelete: Cascade)

  yon         OdemeYonu   @default(Alacak)
  baslik      String
  aciklama    String?
  tutar       Decimal     @db.Decimal(18, 2)
  odenenTutar Decimal     @default(0) @db.Decimal(18, 2)
  paraBirimi  String      @default("TRY") @db.VarChar(3)
  vadeTarihi  DateTime    @db.Date
  durum       OdemeDurumu @default(Beklemede)
  odemeTarihi DateTime?

  faturaId Int? @unique
  fatura   Fatura? @relation(fields: [faturaId], references: [id], onDelete: SetNull)

  // Türe göre değişen ek metadata (harcama profili dışında null kalır)
  // Promosyon: { hedefCariId: number, videoUrl?: string, videoBasligi?: string, platform?: string }
  // Ticaret:   { yatirim: number, getiri: number }
  // Avans:     { geriOdemeTarihi: string, geriOdendi: boolean, geriOdenenTutar?: number }
  detay Json?

  // Distribütör CSV'den geldiyse hangi kayda bağlı
  distributorRaporId Int?
  distributorRapor   DistributorRapor? @relation(fields: [distributorRaporId], references: [id], onDelete: SetNull)

  // Müzik modülü köprü kayıtları
  muzikHarcama  MuzikHarcama?
  sanatciOdemesi SanatciOdemesi? @relation("SanatciOdemesiOdemeNotu")

  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@index([userId, yon, durum])
  @@index([organizationId, yon, durum])
  @@index([organizationId, vadeTarihi])
  @@index([distributorRaporId])
  @@index([cariId])
}

/// Gönderilen veya gelen fatura.
model Fatura {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cariId Int
  cari   Cari @relation(fields: [cariId], references: [id], onDelete: Restrict)

  yon          FaturaYonu   @default(Gonderilen)
  faturaNo     String
  tarih        DateTime     @default(now()) @db.Date
  vadeTarihi   DateTime?    @db.Date
  isAciklamasi String
  tutar        Decimal      @db.Decimal(18, 2)
  kdvOrani     Decimal      @default(20) @db.Decimal(5, 2)
  kdvTutari    Decimal      @default(0) @db.Decimal(18, 2)
  toplamTutar  Decimal      @default(0) @db.Decimal(18, 2)
  odenenTutar  Decimal      @default(0) @db.Decimal(18, 2)
  paraBirimi   String       @default("TRY") @db.VarChar(3)
  durum        FaturaDurumu @default(Beklemede)
  notlar       String?

  odemeNotu      OdemeNotu?
  hatirlaticilar Hatirlatici[]

  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@unique([userId, faturaNo])
  @@index([userId, tarih(sort: Desc)])
  @@index([organizationId, tarih(sort: Desc)])
  @@index([organizationId, yon, durum])
  @@index([cariId])
}

/// Dekont/belge — fatura/alacak/borç/hareket altına eklenen dosya.
model Dekont {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cariId      Int?
  odemeNotuId Int?
  faturaId    Int?
  hareketId   Int?

  dosyaAdi  String
  depoYolu  String
  boyut     Int
  mimeTip   String?
  aciklama  String?

  eklemeTarihi DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([cariId])
  @@index([odemeNotuId])
  @@index([faturaId])
  @@index([hareketId])
}

// ============================================================
//  Ayarlar & Kişiselleştirme
// ============================================================

/// Kullanıcının uygulama içi tercihleri.
model UserSettings {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Tema: light | dark | system
  tema               String  @default("system")
  // Tablo yoğunluğu: comfortable | compact
  yogunluk           String  @default("comfortable")
  // Bildirim tercihleri
  emailBildirim      Boolean @default(true)
  pushBildirim       Boolean @default(false)
  vadeUyariGun       Int     @default(3) // X gün önceden uyar
  // Varsayılanlar
  defaultKdvOrani    Decimal @default(20) @db.Decimal(5, 2)
  defaultParaBirimi  String  @default("TRY") @db.VarChar(3)
  defaultVadeGun     Int     @default(30)
  // Modül toggle'ları — her kullanıcı kendi setup'ında istediği modülleri açar/kapatır.
  // Çekirdek modüller (Alacaklar/Borçlar/Profiller) toggle'lı değil — her zaman açık.
  modulFaturalar      Boolean @default(true)
  modulHareketler     Boolean @default(true)
  modulUrunler        Boolean @default(false) // Service business default kapalı
  modulTekrarlayanlar Boolean @default(true)
  modulHatirlaticilar Boolean @default(true)
  modulEtiketler      Boolean @default(true)

  guncellemeTarihi DateTime @updatedAt
}

/// Faturada ve dekontta basılacak şirket bilgileri.
model SirketBilgisi {
  userId        String  @id
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sirketAdi     String?
  vergiNo       String?
  vergiDairesi  String?
  tcKimlikNo    String?
  adres         String?
  sehir         String?
  ulke          String  @default("Türkiye")
  telefon       String?
  email         String?
  website       String?
  iban          String?
  bankaAdi      String?
  logoUrl       String?
  // Beyaz etiket (kendi marka adıyla satmak için)
  markaAdi      String?
  markaRengi    String? // hex
  markaLogoUrl  String?
  markaAktif    Boolean @default(false)

  guncellemeTarihi DateTime @updatedAt
}

// ============================================================
//  Etiket sistemi
// ============================================================

model Tag {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ad     String
  renk   String @default("gray")
  aciklama String?
  olusturmaTarihi DateTime @default(now())
  cariler CariTag[]

  @@unique([userId, ad])
  @@index([userId])
  @@index([organizationId])
}

model CariTag {
  cariId Int
  tagId  Int
  cari   Cari @relation(fields: [cariId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cariId, tagId])
  @@index([tagId])
}

// ============================================================
//  Hatırlatıcılar / Görevler
// ============================================================

enum HatirlaticiOncelik {
  Dusuk
  Normal
  Yuksek
}

model Hatirlatici {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  baslik           String
  aciklama         String?
  hatirlatmaTarihi DateTime
  tamamlandi       Boolean  @default(false)
  tamamlanmaTarihi DateTime?
  oncelik          HatirlaticiOncelik @default(Normal)
  // İlişkili kayıtlar (opsiyonel)
  cariId   Int?
  cari     Cari?    @relation(fields: [cariId], references: [id], onDelete: SetNull)
  faturaId Int?
  fatura   Fatura?  @relation(fields: [faturaId], references: [id], onDelete: SetNull)

  olusturmaTarihi DateTime @default(now())

  @@index([userId, tamamlandi, hatirlatmaTarihi])
  @@index([organizationId, tamamlandi, hatirlatmaTarihi])
  @@index([cariId])
  @@index([faturaId])
}

// ============================================================
//  Tekrarlayan kayıtlar (kira, abonelik vs.)
// ============================================================

enum TekrarSiklik {
  Gunluk
  Haftalik
  Aylik
  Uc_Aylik
  Alti_Aylik
  Yillik
}

enum TekrarTip {
  Fatura
  OdemeNotu
}

model TekrarlayanKayit {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ad     String
  tip    TekrarTip @default(OdemeNotu)
  cariId Int
  cari   Cari @relation(fields: [cariId], references: [id], onDelete: Cascade)
  // Şablon değerler
  yon         String  // "Alacak" | "Borc" — OdemeYonu enum string olarak
  tutar       Decimal @db.Decimal(18, 2)
  kdvOrani    Decimal @default(20) @db.Decimal(5, 2)
  paraBirimi  String  @default("TRY") @db.VarChar(3)
  aciklama    String?
  vadeGun     Int     @default(30) // Üretim anından kaç gün sonra vade
  // Zamanlama
  siklik         TekrarSiklik
  baslangicTarihi DateTime @db.Date
  sonrakiTarih    DateTime @db.Date
  bitisTarihi    DateTime? @db.Date
  uretilenAdet   Int      @default(0)
  // Durum
  aktif          Boolean @default(true)
  sonUretimTarihi DateTime?

  olusturmaTarihi DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@index([userId, aktif, sonrakiTarih])
  @@index([organizationId, aktif, sonrakiTarih])
  @@index([cariId])
}

// ============================================================
//  Stok / Ürün
// ============================================================

enum StokHareketTipi {
  Giris  // alış, dönüş, sayım fazlası
  Cikis  // satış, fire, sayım eksiği
  Duzeltme
}

model Urun {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kod    String
  ad     String
  aciklama String?
  birim  String  @default("Adet") // Adet, Kg, Lt, Mt, M2, M3, Saat, Paket
  // Fiyatlandırma
  satisFiyati  Decimal @db.Decimal(18, 2)
  alisFiyati   Decimal? @db.Decimal(18, 2)
  kdvOrani     Decimal @default(20) @db.Decimal(5, 2)
  paraBirimi   String  @default("TRY") @db.VarChar(3)
  // Stok
  stok         Decimal @default(0) @db.Decimal(18, 3)
  minStok      Decimal @default(0) @db.Decimal(18, 3)
  // Sınıflandırma
  kategori     String?
  barkod       String?
  aktif        Boolean @default(true)

  olusturmaTarihi DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  hareketler StokHareketi[]

  @@unique([userId, kod])
  @@index([userId, aktif])
  @@index([organizationId, aktif])
  @@index([organizationId, kategori])
  @@index([organizationId, ad])
}

model StokHareketi {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  urunId Int
  urun   Urun @relation(fields: [urunId], references: [id], onDelete: Cascade)
  tip       StokHareketTipi
  miktar    Decimal @db.Decimal(18, 3)
  birimFiyat Decimal? @db.Decimal(18, 2)
  toplamTutar Decimal? @db.Decimal(18, 2)
  notlar    String?
  belgeNo   String?
  tarih     DateTime @default(now()) @db.Date
  // Önceki ve sonraki stok (audit için)
  oncekiStok Decimal @db.Decimal(18, 3)
  sonrakiStok Decimal @db.Decimal(18, 3)

  olusturmaTarihi DateTime @default(now())

  @@index([userId, tarih(sort: Desc)])
  @@index([organizationId, tarih(sort: Desc)])
  @@index([urunId, tarih(sort: Desc)])
}

// ============================================================
//  Audit Log
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  islem     String
  entity    String
  entityId  String?
  ozet      String
  oncesi    Json?
  sonrasi   Json?
  ip        String?
  userAgent String?  @db.Text

  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entity, entityId])
}


// ============================================================
//  Çek / Senet
// ============================================================

enum CekSenetTip {
  Cek
  Senet
}

enum CekSenetYon {
  Alinan
  Verilen
}

enum CekSenetDurum {
  Portfoyde
  TahsileGonderildi
  Tahsil
  Iade
  Karsiliksiz
  Iptal
}

model CekSenet {
  id   Int @id @default(autoincrement())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  cariId Int?
  cari   Cari? @relation(fields: [cariId], references: [id], onDelete: SetNull)

  tip         CekSenetTip
  yon         CekSenetYon
  durum       CekSenetDurum @default(Portfoyde)

  belgeNo     String
  bankaAdi    String?
  sube        String?
  hesapNo     String?
  keside      String?

  tutar       Decimal  @db.Decimal(18, 2)
  paraBirimi  String   @default("TRY") @db.VarChar(3)

  kesideTarihi DateTime
  vadeTarihi   DateTime
  tahsilTarihi DateTime?

  aciklama    String?  @db.Text

  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@index([organizationId, durum])
  @@index([organizationId, vadeTarihi])
  @@index([cariId])
}

// ============================================================
//  Kasa (TL, USD, EUR vb. — birden fazla olabilir)
// ============================================================

model Kasa {
  id   Int @id @default(autoincrement())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ad         String
  paraBirimi String  @default("TRY") @db.VarChar(3)
  acilis     Decimal @default(0) @db.Decimal(18, 2)
  aktif      Boolean @default(true)
  varsayilan Boolean @default(false)
  aciklama   String? @db.Text

  hareketler KasaHareketi[]
  // Müzik modülü kaynak kasa
  muzikHarcamalari MuzikHarcama[]
  sanatciOdemeleri SanatciOdemesi[] @relation("SanatciOdemesiKasa")

  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@index([organizationId])
}

enum KasaHareketTip {
  Giris    // para girişi (tahsilat, devir vs)
  Cikis    // para çıkışı (ödeme, gider vs)
  Transfer // başka kasaya transfer
}

model KasaHareketi {
  id   Int @id @default(autoincrement())

  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  kasaId Int
  kasa   Kasa @relation(fields: [kasaId], references: [id], onDelete: Cascade)

  // Transfer için karşı kasa
  hedefKasaId Int?

  tip        KasaHareketTip
  tutar      Decimal @db.Decimal(18, 2)
  paraBirimi String  @default("TRY") @db.VarChar(3)

  tarih      DateTime
  aciklama   String? @db.Text
  belgeNo    String?

  olusturmaTarihi DateTime @default(now())

  // Müzik modülü köprü kaydı (delete cascade için)
  muzikHarcama   MuzikHarcama?
  sanatciOdemesi SanatciOdemesi? @relation("SanatciOdemesiKasaHareketi")

  @@index([organizationId, tarih(sort: Desc)])
  @@index([kasaId, tarih(sort: Desc)])
}

// ============================================================
//  Distribütör Rapor (CSV upload + parse + kazanç hesabı)
// ============================================================
// Kullanıcı Spotify/YouTube/Apple gibi platformlardan gelen
// gelir raporlarını CSV olarak yükler. Her satır bir track/video
// olabilir. Toplam gelir hesaplanır, isteğe bağlı promosyon
// kayıtlarıyla ROI çıkarılır.

model DistributorRapor {
  id   Int @id @default(autoincrement())

  userId         String
  user           User        @relation("DistributorUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ad           String     // "Spotify Mart 2026" gibi
  platform     String?    // "Spotify" | "YouTube" | "Apple Music" | custom
  donem        String     // "2026-03" formatında dönem
  dosyaAdi     String?    // original CSV filename
  depoYolu     String?    // saved csv path (uploads/distributor/...)

  toplamGelir  Decimal    @default(0) @db.Decimal(18, 2)
  paraBirimi   String     @default("TRY") @db.VarChar(3)
  toplamStream Int        @default(0)
  satirSayisi  Int        @default(0)

  notlar       String?    @db.Text
  // Parser sonucu (satır detayları, kolon eşleştirmeleri vs)
  rawData      Json?

  // İlişkili kayıtlar (promosyon eşleştirmesi)
  odemeNotlari OdemeNotu[]

  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  @@index([organizationId, donem])
  @@index([userId])
}

// ============================================================
//  Müzik Ödemeleri modülü
//  - Bir müzik için izole gelir / harcama / sanatçı ödemesi defteri.
//  - Harcama kaydedildiğinde opsiyonel olarak `Hareket` + `OdemeNotu`
//    (Borç) + `KasaHareketi` create edilir → muhasebeye yansır.
//  - Sanatçılar, Promoter'lar, İşbirlikçiler `Cari` tablosunda tutulur
//    (tip=Harcama + harcamaTuru=Sanatci/Promoter/Isbirlikci).
// ============================================================

/// Dağıtılan tekil müzik (örn. "Montagem Vezes Lamento").
model MuzikProfil {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  isim String
  slug String
  // İşbirlikçiler: serbest text liste ("Mix: Studio Atlas", "Master: Phonk Lab")
  isbirlikciler String[] @default([])
  // Yayın mağazaları
  magazalar     MuzikMagaza[] @default([])
  notlar        String?
  aktif         Boolean       @default(true)

  olusturmaTarihi  DateTime @default(now())
  guncellemeTarihi DateTime @updatedAt

  sanatcilar     MuzikProfilSanatci[]
  gelirler       MuzikGelir[]
  harcamalar     MuzikHarcama[]
  sanatciOdemeleri SanatciOdemesi[]

  @@unique([organizationId, slug])
  @@index([organizationId, aktif])
  @@index([userId])
}

/// Müzik ↔ Sanatçı (Cari) many-to-many. Yüzde yok, sadece kim çaldı.
model MuzikProfilSanatci {
  muzikProfilId Int
  muzikProfil   MuzikProfil @relation(fields: [muzikProfilId], references: [id], onDelete: Cascade)
  // Sanatçı = Cari (tip=Harcama, harcamaTuru=Sanatci)
  cariId Int
  cari   Cari @relation(fields: [cariId], references: [id], onDelete: Cascade)

  olusturmaTarihi DateTime @default(now())

  @@id([muzikProfilId, cariId])
  @@index([cariId])
}

/// Müzik geliri kaydı (Spotify/YouTube payout, content ID claim vs.).
model MuzikGelir {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  muzikProfilId Int
  muzikProfil   MuzikProfil @relation(fields: [muzikProfilId], references: [id], onDelete: Cascade)

  tarih      DateTime     @db.Date
  platform   MuzikMagaza? // opsiyonel — hangi mağazadan geldi
  tutar      Decimal      @db.Decimal(18, 2)
  paraBirimi String       @default("USD") @db.VarChar(3)
  not        String?

  olusturmaTarihi DateTime @default(now())

  @@index([muzikProfilId, tarih(sort: Desc)])
  @@index([organizationId, tarih(sort: Desc)])
  @@index([userId])
}

/// Müzik harcaması (reklam, tasarım, prodüksiyon, klip vs.).
/// `borclaraYansit=true` ise create sırasında `Hareket` + `OdemeNotu`
/// + `KasaHareketi` kayıtları transaction içinde oluşturulur.
model MuzikHarcama {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  muzikProfilId Int
  muzikProfil   MuzikProfil @relation(fields: [muzikProfilId], references: [id], onDelete: Cascade)

  tarih      DateTime              @db.Date
  kategori   MuzikHarcamaKategori? // opsiyonel
  tutar      Decimal               @db.Decimal(18, 2)
  paraBirimi String                @default("USD") @db.VarChar(3)
  not        String?

  // Promoter'a yapılan reklam harcaması ise burası dolar (Cari'de tip=Harcama, harcamaTuru=Promoter)
  promoterCariId Int?
  promoterCari   Cari? @relation("MuzikHarcamaPromoter", fields: [promoterCariId], references: [id], onDelete: SetNull)

  // Kaynak kasa (hangi kasadan çıktı) — Kasa modülü açık değilse null kalır
  kasaId Int?
  kasa   Kasa? @relation(fields: [kasaId], references: [id], onDelete: SetNull)

  // "Borçlar'a da kaydet" toggle — true ise Hareket+OdemeNotu+KasaHareketi oluşturulur
  borclaraYansit Boolean @default(true)

  // Köprü kayıtları (transaction içinde set edilir, edit/delete sırasında cascade güncellenir)
  hareketId   Int?     @unique
  hareket     Hareket? @relation(fields: [hareketId], references: [id], onDelete: SetNull)
  odemeNotuId Int?     @unique
  odemeNotu   OdemeNotu? @relation(fields: [odemeNotuId], references: [id], onDelete: SetNull)
  kasaHareketiId Int?  @unique
  kasaHareketi   KasaHareketi? @relation(fields: [kasaHareketiId], references: [id], onDelete: SetNull)

  olusturmaTarihi DateTime @default(now())

  @@index([muzikProfilId, tarih(sort: Desc)])
  @@index([organizationId, tarih(sort: Desc)])
  @@index([promoterCariId])
  @@index([userId])
}

/// Bir müzik için sanatçıya yapılan ödeme. Yüzde yok, manuel tutar.
model SanatciOdemesi {
  id     Int    @id @default(autoincrement())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  muzikProfilId Int
  muzikProfil   MuzikProfil @relation(fields: [muzikProfilId], references: [id], onDelete: Cascade)

  // Sanatçı = Cari (tip=Harcama, harcamaTuru=Sanatci)
  sanatciCariId Int
  sanatciCari   Cari @relation(fields: [sanatciCariId], references: [id], onDelete: Cascade)

  tarih      DateTime @db.Date
  tutar      Decimal  @db.Decimal(18, 2)
  paraBirimi String   @default("USD") @db.VarChar(3)
  not        String?

  // Borçlar/Kasa entegrasyonu (harcamayla aynı pattern)
  borclaraYansit Boolean @default(true)
  kasaId         Int?
  kasa           Kasa?   @relation("SanatciOdemesiKasa", fields: [kasaId], references: [id], onDelete: SetNull)
  hareketId      Int?    @unique
  hareket        Hareket? @relation("SanatciOdemesiHareket", fields: [hareketId], references: [id], onDelete: SetNull)
  odemeNotuId    Int?    @unique
  odemeNotu      OdemeNotu? @relation("SanatciOdemesiOdemeNotu", fields: [odemeNotuId], references: [id], onDelete: SetNull)
  kasaHareketiId Int?    @unique
  kasaHareketi   KasaHareketi? @relation("SanatciOdemesiKasaHareketi", fields: [kasaHareketiId], references: [id], onDelete: SetNull)

  olusturmaTarihi DateTime @default(now())

  @@index([muzikProfilId, tarih(sort: Desc)])
  @@index([sanatciCariId, tarih(sort: Desc)])
  @@index([organizationId, tarih(sort: Desc)])
  @@index([userId])
}
