{
  "name": "muhasebe-pro-v2",
  "version": "1.0.1",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "electron:build": "tsc -p electron/tsconfig.json && cp electron/offline.html dist-electron/offline.html && (cp -r electron/icons dist-electron/icons 2>/dev/null || true)",
    "electron:dev": "concurrently -k -n NEXT,ELECTRON -c yellow,cyan \"next dev\" \"wait-on http://localhost:3000 && pnpm electron:build && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "electron:start": "pnpm electron:build && cross-env APP_URL=https://muhasebe.oceanyazilim.com electron dist-electron/main.js",
    "electron:pack": "pnpm electron:build && electron-builder --dir",
    "electron:mac": "pnpm electron:build && electron-builder --mac",
    "electron:win": "pnpm electron:build && electron-builder --win",
    "electron:linux": "pnpm electron:build && electron-builder --linux",
    "electron:all": "pnpm electron:build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.oceanyazilim.muhasebepro",
    "productName": "Muhasebe Pro",
    "copyright": "Copyright © 2026 Ocean Yazılım",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.js"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "electron/icons/icon.png",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "dmg": {
      "title": "Muhasebe Pro ${version}",
      "icon": "electron/icons/icon.png",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 400
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Muhasebe Pro"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icons/icon.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "grxtor",
        "repo": "muhasebe-pro-v2",
        "releaseType": "release"
      }
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "@parcel/watcher",
      "@swc/core",
      "bcrypt",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@heroui/react": "^3.0.4",
    "@heroui/styles": "^3.0.4",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "^4.12.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "tailwind-variants": "^3.2.2",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.10"
  }
}
